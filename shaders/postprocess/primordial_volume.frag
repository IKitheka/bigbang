#version 330 core
// M1 native C++/GLSL first-pass cosmic fluctuation volume. All pixels are
// generated by this GPU/GLSL program, never by Blender or a cached movie.
// It is a speculative visual metaphor, NOT a physical inflation solver.
in vec2 TexCoords;
out vec4 FragColor;

uniform float uTime;
uniform vec3 uCameraPos;
uniform vec3 uCameraForward;
uniform vec3 uCameraRight;
uniform vec3 uCameraUp;
uniform float uAspect;
uniform float uTanHalfFovY;

float hash31(vec3 p) {
    p = fract(p * 0.1031);
    p += dot(p, p.yzx + 33.33);
    return fract((p.x + p.y) * p.z);
}

float valueNoise(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    f = f*f*(3.0-2.0*f);
    float n000 = hash31(i);
    float n100 = hash31(i+vec3(1,0,0));
    float n010 = hash31(i+vec3(0,1,0));
    float n110 = hash31(i+vec3(1,1,0));
    float n001 = hash31(i+vec3(0,0,1));
    float n101 = hash31(i+vec3(1,0,1));
    float n011 = hash31(i+vec3(0,1,1));
    float n111 = hash31(i+vec3(1,1,1));
    float a = mix(mix(n000,n100,f.x),mix(n010,n110,f.x),f.y);
    float b = mix(mix(n001,n101,f.x),mix(n011,n111,f.x),f.y);
    return mix(a,b,f.z);
}

float fbm(vec3 p) {
    return 0.60*valueNoise(p)+0.28*valueNoise(p*2.02+17.4)
        +0.12*valueNoise(p*4.05-8.9);
}

float activity(float t) {
    return smoothstep(4.5, 12.0, t) * (1.0-smoothstep(45.0,54.0,t));
}

// World-anchored, gently expanding length scales: no radial explosive shell,
// camera-facing noise plane, or visible sphere boundary.
float coherentStructure(vec3 p,float t) {
    float scale = 1.0 + 0.019*max(0.0,t-8.0);
    vec3 q = p/scale;
    float warp = fbm(q*0.125);
    float wave1 = sin(dot(q,vec3(0.49,0.23,0.38)) + 2.4*(warp-0.5));
    float wave2 = sin(dot(q,vec3(-0.25,0.44,0.17)) - 1.7*(warp-0.5));
    // Squared narrow ridges provide thin, corrugated, 3D wave sheets.
    float ribbons = exp(-46.0*wave1*wave1)
                  + 0.58*exp(-58.0*wave2*wave2);
    float envelope = smoothstep(0.38,0.74,fbm(q*0.18+vec3(8.2,1.1,4.8)));
    return min(1.0,ribbons*envelope);
}

void main() {
    vec2 xy = TexCoords*2.0-vec2(1.0);
    vec3 ray = normalize(uCameraForward+
        (xy.x*uAspect*uTanHalfFovY)*uCameraRight+
        (xy.y*uTanHalfFovY)*uCameraUp);

    float visibility = activity(uTime);
    if (visibility <= 0.0001) {
        FragColor = vec4(0.0,0.0,0.0,1.0);
        return;
    }

    // Bounded 64-step ray marching in camera space, fixed budget at every
    // resolution. The field has no finite geometric boundary or black sphere.
    const int STEPS = 64;
    const float STEP_LENGTH = 0.63;
    float transmit = 1.0;
    vec3 radiance = vec3(0.0);
    float expansion = smoothstep(10.0,33.0,uTime);
    vec3 cold = vec3(0.12,0.21,0.34);
    vec3 silver = vec3(0.65,0.72,0.82);

    for (int i=0; i<STEPS; ++i) {
        vec3 p = uCameraPos + ray*(0.55+(float(i)+0.5)*STEP_LENGTH);
        float coherence = coherentStructure(p,uTime);
        if (coherence<0.015) continue;

        // Sparse modulation keeps deep black negative space, rather than
        // a uniform blue/grey cloud or overexposed filled frame.
        float detail = fbm(p*0.105+vec3(4.1,0.2,2.2));
        float fractal = smoothstep(0.33,0.80,detail);
        float density = visibility * coherence * fractal * 0.052;
        float alpha = 1.0-exp(-density*STEP_LENGTH);
        vec3 palette = mix(cold,silver,clamp(0.16+0.65*coherence+0.12*detail,0.0,1.0));
        float glow = mix(1.0,1.15,expansion);
        radiance += transmit*alpha*palette*glow;
        transmit *= 1.0-alpha;
        if (transmit < 0.018) break;
    }
    // Scene-linear radiance only. Existing native HDR FBO + conservative
    // post-process handles display mapping. No white point light or flash.
    FragColor = vec4(radiance,1.0);
}
